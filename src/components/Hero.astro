---
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const prefix = locale === 'en' ? '/en' : '';
---

<section class="relative overflow-hidden bg-brand-charcoal text-white">
  <img
    src="/images/products/focaccia-olive.jpg"
    alt=""
    class="absolute inset-0 w-full h-full object-cover opacity-30"
    width="800"
    height="600"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-brand-charcoal/70 via-brand-charcoal/50 to-brand-charcoal/90 z-10" />

  <div class="relative z-20 max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-32 text-center">
    <span class="inline-block bg-brand-orange/90 text-white text-xs sm:text-sm font-semibold px-4 py-1.5 rounded-full mb-6 tracking-wide uppercase">
      {i18n.hero.badge}
    </span>

    <h1 class="font-display font-900 text-4xl sm:text-5xl lg:text-6xl leading-tight max-w-3xl mx-auto mb-6">
      {i18n.hero.title}
    </h1>

    <p class="text-white/80 text-lg sm:text-xl max-w-xl mx-auto mb-10">
      {i18n.hero.subtitle}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`${prefix}/#nabidka`}
        class="inline-flex items-center px-8 py-3.5 bg-brand-orange text-white font-semibold rounded-lg hover:bg-brand-orange-hover transition-colors text-base"
      >
        {i18n.hero.cta}
      </a>
      <a
        href={`${prefix}/#pobocky`}
        class="inline-flex items-center px-8 py-3.5 border-2 border-white/30 text-white font-semibold rounded-lg hover:border-white/60 transition-colors text-base"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {i18n.hero.findUs}
      </a>
    </div>
  </div>
</section>
