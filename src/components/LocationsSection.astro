---
import { t, type Locale } from '../data/i18n';
import locations from '../data/locations.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);

const dayKeys = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'] as const;
const dayLabels = {
  mon: i18n.locations.mon,
  tue: i18n.locations.tue,
  wed: i18n.locations.wed,
  thu: i18n.locations.thu,
  fri: i18n.locations.fri,
  sat: i18n.locations.sat,
  sun: i18n.locations.sun,
};
---

<section id="pobocky" class="py-16 sm:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl mb-3">{i18n.locations.title}</h2>
      <p class="text-brand-muted">{i18n.locations.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {locations.map((loc) => (
        <div class="bg-brand-cream rounded-xl p-6 border border-brand-warm/30">
          <div class="mb-4">
            <h3 class="font-display font-bold text-xl mb-1">{loc.label[locale]}</h3>
            <p class="text-sm text-brand-muted">{loc.address}</p>
            {loc.rating && (
              <p class="text-sm mt-1">
                <span class="text-brand-orange-text font-semibold">{loc.rating}★</span>
                <span class="text-brand-muted ml-1">({loc.reviewCount} {i18n.locations.reviews})</span>
              </p>
            )}
          </div>

          <div class="mb-5">
            <h4 class="text-xs uppercase tracking-wider text-brand-muted font-semibold mb-2">{i18n.locations.hours}</h4>
            <div class="space-y-1">
              {dayKeys.map((day) => {
                const hours = loc.hours[day];
                return (
                  <div class="flex justify-between text-sm">
                    <span class="text-brand-muted">{dayLabels[day]}</span>
                    <span class={hours ? 'font-medium' : 'text-brand-muted'}>
                      {hours || (locale === 'cs' ? 'Zavřeno' : 'Closed')}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="flex gap-3">
            <a
              href={loc.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-orange-deep text-white text-sm font-semibold rounded-lg hover:bg-brand-orange-hover transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {i18n.locations.navigate}
            </a>
            {loc.phone && (
              <a
                href={`tel:${loc.phone}`}
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 border-2 border-brand-warm text-brand-charcoal text-sm font-semibold rounded-lg hover:bg-brand-warm transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                {i18n.locations.call}
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
