---
import Placeholder from './Placeholder.astro';
import { t, type Locale } from '../data/i18n';
import { withBase } from '../lib/paths';
import { route } from '../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const year = new Date().getFullYear();
---

<footer class="ground-ink border-t-4 border-brand-orange">
  <div class="max-w-page mx-auto px-s4 py-s7 flex flex-col gap-s5">
    <div class="flex flex-wrap gap-s5 justify-between">
      <div class="flex flex-col gap-s3">
        <div class="flex items-center gap-s2">
          <img
            src={withBase('/logo.svg')}
            alt="Bread Guy"
            width="40"
            height="40"
            class="w-logo h-logo"
          />
          <span class="font-display text-t4 text-brand-orange">bread guy</span>
        </div>
        <nav class="flex flex-wrap gap-s4 font-utility font-bold uppercase text-t2">
          <a href={route('menu', locale)}>{i18n.nav.menu}</a>
          <a href={route('locations', locale)}>{i18n.nav.locations}</a>
          <a href={route('about', locale)}>{i18n.nav.about}</a>
          <a href={route('order', locale)}>{i18n.order.title}</a>
        </nav>
      </div>

      <div class="flex flex-col gap-s3">
        <a
          class="font-utility font-bold uppercase text-t2 text-brand-orange"
          href="https://www.instagram.com/breadguybrno"
          target="_blank"
          rel="noopener noreferrer"
        >
          @breadguybrno
        </a>
        {/* Company registration numbers are a legal identifier, not decoration.
            The owner has not supplied them, so the gap is shown rather than the
            field being quietly dropped. */}
        <Placeholder label={`${i18n.footer.ico} / ${i18n.footer.dic}`} />
      </div>
    </div>

    <p class="text-t1 font-utility uppercase">
      &copy; {year} Bread Guy. {i18n.footer.rights}
    </p>
  </div>
</footer>
