---
import { withBase } from '../lib/paths';

interface Props {
  /** Base name in public/images/full/. */
  file: string;
  alt: string;
}

const { file, alt } = Astro.props;

/*
 * Overhead full-frame shots get full-bleed treatment; isolated subjects get
 * cutout treatment. These two photographs have no usable cutout precisely
 * because the food fills the frame — which is exactly what makes them work
 * edge to edge. See DECISIONS.md.
 */
---

<div class="w-full overflow-hidden aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]">
  <img
    src={withBase(`/images/full/${file}-1600.webp`)}
    srcset={`${withBase(`/images/full/${file}-800.webp`)} 800w, ${withBase(`/images/full/${file}-1600.webp`)} 1600w`}
    sizes="100vw"
    alt={alt}
    width="1600"
    height="1200"
    loading="lazy"
    decoding="async"
    class="w-full h-full object-cover block"
  />
</div>
