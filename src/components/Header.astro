---
import { t, type Locale } from '../data/i18n';
import { toRoute, withBase } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
const prefix = locale === 'en' ? '/en' : '';
const altLocale = locale === 'cs' ? 'en' : 'cs';
const altPrefix = locale === 'cs' ? '/en' : '';
const currentPath = toRoute(Astro.url.pathname);
const altRoute = locale === 'cs'
  ? (currentPath === '/' ? '/en/' : `/en${currentPath}`)
  : currentPath.replace(/^\/en/, '') || '/';
const altPath = withBase(altRoute);
---

<header class="sticky top-0 z-50 bg-brand-cream/95 backdrop-blur-sm border-b border-brand-warm/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href={withBase(`${prefix}/`)} class="flex items-center gap-2">
      <img src={withBase("/logo.svg")} alt="" class="h-10 w-10" />
      {/* 20px at weight 900 counts as WCAG large text, so the logo orange
          clears the 3:1 bar here and stays matched to the mark beside it. */}
      <span class="font-display font-black text-xl text-brand-orange">bread guy</span>
    </a>

    <nav class="hidden sm:flex items-center gap-6 text-sm font-medium">
      <a href={withBase(`${prefix}/#nabidka`)} class="hover:text-brand-orange-text transition-colors">{i18n.nav.menu}</a>
      <a href={withBase(`${prefix}/#pobocky`)} class="hover:text-brand-orange-text transition-colors">{i18n.nav.locations}</a>
      <a href={withBase(`${prefix}/#o-nas`)} class="hover:text-brand-orange-text transition-colors">{i18n.nav.about}</a>
      <a
        href={altPath}
        hreflang={altLocale}
        lang={altLocale}
        aria-label={i18n.nav.switchLanguage}
        class="uppercase text-xs px-2 py-1 border border-brand-warm rounded hover:bg-brand-warm transition-colors"
      >
        {altLocale.toUpperCase()}
      </a>
    </nav>

    <button
      id="mobile-menu-btn"
      class="sm:hidden p-2 -mr-2"
      aria-label={i18n.nav.menu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="sm:hidden hidden border-t border-brand-warm/50 bg-brand-cream">
    <div class="px-4 py-3 space-y-3">
      <a href={withBase(`${prefix}/#nabidka`)} class="block text-sm font-medium hover:text-brand-orange-text">{i18n.nav.menu}</a>
      <a href={withBase(`${prefix}/#pobocky`)} class="block text-sm font-medium hover:text-brand-orange-text">{i18n.nav.locations}</a>
      <a href={withBase(`${prefix}/#o-nas`)} class="block text-sm font-medium hover:text-brand-orange-text">{i18n.nav.about}</a>
      <a
        href={altPath}
        hreflang={altLocale}
        lang={altLocale}
        aria-label={i18n.nav.switchLanguage}
        class="inline-block uppercase text-xs px-2 py-1 border border-brand-warm rounded hover:bg-brand-warm"
      >
        {altLocale.toUpperCase()}
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
