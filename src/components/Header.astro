---
import { t, type Locale } from '../data/i18n';
import { withBase } from '../lib/paths';
import { route, otherLocale, type PageKey } from '../lib/routes';

interface Props {
  locale: Locale;
  /** Which page we are on, so the language switch stays on it. */
  page: PageKey;
  /** Product slug, when the current page is a product detail. */
  slug?: string;
}

const { locale, page, slug } = Astro.props;
const i18n = t(locale);
const other = otherLocale(locale);

const links: Array<[string, string]> = [
  [i18n.nav.menu, route('menu', locale)],
  [i18n.nav.locations, route('locations', locale)],
  [i18n.nav.about, route('about', locale)],
];
---

<header class="ground-ink sticky top-0 z-40 border-b-4 border-brand-orange">
  <div class="max-w-page mx-auto px-s4 h-header flex items-center justify-between gap-s3">
    <a href={route('home', locale)} class="flex items-center gap-s2 shrink-0">
      <img
        src={withBase('/logo.svg')}
        alt="Bread Guy"
        width="40"
        height="40"
        class="w-logo h-logo"
      />
      <span class="font-display text-t4 text-brand-orange hidden sm:inline">bread guy</span>
    </a>

    <nav class="hidden md:flex items-center gap-s5 font-utility font-bold uppercase text-t2">
      {links.map(([label, href]) => <a href={href} class="hover:text-brand-orange">{label}</a>)}
    </nav>

    <div class="flex items-center gap-s2">
      {/* The order route is reachable from every page and stays visible at
          390px with the drawer shut. It is not a nav item that scrolls away. */}
      <a
        href={route('order', locale)}
        class="tag-notch bg-brand-orange text-brand-ink font-utility font-bold uppercase text-t2 px-s3 py-s2"
      >
        {i18n.nav.order}
      </a>

      <a
        href={route(page, other, slug)}
        hreflang={other}
        lang={other}
        aria-label={`${other.toUpperCase()} — ${i18n.nav.switchLanguage}`}
        class="font-utility font-bold uppercase text-t1 px-s2 py-s1 border-2 border-brand-chalk hover:bg-brand-chalk hover:text-brand-ink"
      >
        {other}
      </a>

      {/* A <details> drawer opens and closes with no JavaScript at all. */}
      <details class="md:hidden relative">
        <summary
          class="list-none cursor-pointer font-utility font-bold uppercase text-t2 px-s3 py-s1 border-2 border-brand-chalk"
          aria-label={i18n.nav.openMenu}
        >
          ≡
        </summary>
        <div
          class="absolute right-0 top-full mt-s2 ground-ink border-2 border-brand-orange p-s3 flex flex-col gap-s3 font-utility font-bold uppercase text-t2 whitespace-nowrap"
        >
          {links.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </details>
    </div>
  </div>
</header>
