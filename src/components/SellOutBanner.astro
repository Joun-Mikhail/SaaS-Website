---
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);
---

<div class="bg-brand-orange-deep/10 border-l-4 border-brand-orange px-4 py-3 max-w-6xl mx-4 sm:mx-auto mt-4 sm:mt-6 rounded-r-lg">
  <p class="text-sm text-brand-charcoal/80">
    <span class="font-semibold">{locale === 'cs' ? 'Tip:' : 'Tip:'}</span>
    {' '}{i18n.sellOutWarning}
  </p>
</div>
