---
import { t, type Locale } from '../data/i18n';
import products from '../data/products.json';
import { withBase } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = t(locale);

const categories = [
  { key: 'all', label: i18n.menu.all },
  { key: 'bread', label: i18n.menu.bread },
  { key: 'sweets', label: i18n.menu.sweets },
  { key: 'sandwiches', label: i18n.menu.sandwiches },
];

function formatPrice(product: (typeof products)[number]): string {
  if ('priceWhole' in product && product.priceWhole) {
    return `${product.priceWhole} / ${product.priceHalf} ${i18n.menu.currency}`;
  }
  if ('priceFrom' in product && product.priceFrom) {
    return `${product.priceFrom}–${product.priceTo} ${i18n.menu.currency}`;
  }
  if ('price' in product && product.price) {
    return `${product.price} ${i18n.menu.currency}`;
  }
  return '';
}

function formatPriceDetail(product: (typeof products)[number]): string {
  if ('priceWhole' in product && product.priceWhole) {
    return `${i18n.menu.whole} / ${i18n.menu.half}`;
  }
  if ('priceFrom' in product && product.priceFrom) {
    return i18n.menu.from;
  }
  return '';
}
---

<section id="nabidka" class="py-16 sm:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl mb-3">{i18n.menu.title}</h2>
      <p class="text-brand-muted max-w-lg mx-auto">{i18n.menu.subtitle}</p>
    </div>

    <div
      class="flex flex-wrap justify-center gap-2 mb-10"
      id="category-filters"
      role="group"
      aria-label={i18n.menu.filterLabel}
    >
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.key}
          aria-pressed={idx === 0 ? 'true' : 'false'}
          class={`px-4 py-2 text-sm font-medium rounded-full transition-colors ${
            idx === 0
              ? 'bg-brand-orange-deep text-white'
              : 'bg-brand-warm/50 text-brand-charcoal/70 hover:bg-brand-warm'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="product-grid">
      {products.map((product) => {
        const price = formatPrice(product);
        const detail = formatPriceDetail(product);
        return (
          <div
            data-category={product.category}
            class="product-card bg-white rounded-xl overflow-hidden border border-brand-warm/30 hover:border-brand-orange/30 hover:shadow-md transition-all"
          >
            <div class="aspect-[4/3] overflow-hidden bg-brand-warm/30">
              {product.image ? (
                <img
                  src={withBase(product.image)}
                  alt={`${product.name[locale]} — ${product.description[locale]}`}
                  class="product-photo w-full h-full object-cover duration-300"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="600"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
                  <img src={withBase("/logo.svg")} alt="" class="w-12 h-12 opacity-25" width="48" height="48" />
                </div>
              )}
            </div>
            <div class="p-4">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="font-display font-bold text-lg">{product.name[locale]}</h3>
                  <p class="text-sm text-brand-muted mt-1">{product.description[locale]}</p>
                </div>
                <div class="flex-shrink-0">
                  {product.available ? (
                    <span class="inline-flex items-center gap-1 text-xs text-brand-open bg-green-50 px-2 py-0.5 rounded-full">
                      <span class="w-1.5 h-1.5 bg-brand-open rounded-full" />
                      {i18n.menu.available}
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 text-xs text-brand-closed bg-red-50 px-2 py-0.5 rounded-full">
                      <span class="w-1.5 h-1.5 bg-brand-closed rounded-full" />
                      {i18n.menu.soldOut}
                    </span>
                  )}
                </div>
              </div>
              {price && (
                <div class="mt-3 pt-3 border-t border-brand-warm/20">
                  <span class="font-semibold text-brand-orange-text">{price}</span>
                  {detail && (
                    <span class="text-xs text-brand-muted ml-1">({detail})</span>
                  )}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('#category-filters button');
  const cards = document.querySelectorAll('.product-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');

      buttons.forEach((b) => {
        b.classList.remove('bg-brand-orange-deep', 'text-white');
        b.classList.add('bg-brand-warm/50', 'text-brand-charcoal/70');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('bg-brand-orange-deep', 'text-white');
      btn.classList.remove('bg-brand-warm/50', 'text-brand-charcoal/70');
      btn.setAttribute('aria-pressed', 'true');

      cards.forEach((card) => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
