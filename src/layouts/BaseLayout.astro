---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../data/i18n';
import { withBase } from '../lib/paths';
import { route, otherLocale, type PageKey } from '../lib/routes';
import locations from '../data/locations.json';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  page: PageKey;
  slug?: string;
}

const { title, description, locale, page, slug } = Astro.props;
const i18n = t(locale);
const other = otherLocale(locale);

const SITE = Astro.site?.origin ?? 'https://breadguy.cz';
const absolute = (path: string) => `${SITE}${path}`;
const canonical = absolute(route(page, locale, slug));

/* No aggregateRating. A star rating published under a real business's name is
   a factual claim about that business, and no figure has been supplied. */
const structuredData = locations.map((loc) => ({
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: loc.name[locale],
  address: {
    '@type': 'PostalAddress',
    streetAddress: loc.address.split(',')[0],
    addressLocality: 'Brno',
    addressCountry: 'CZ',
  },
  telephone: loc.phone || undefined,
  url: absolute(route('home', locale)),
  openingHoursSpecification: Object.entries(loc.hours)
    .filter(([, v]) => v !== null)
    .map(([day, hours]) => {
      const dayMap: Record<string, string> = {
        mon: 'Monday',
        tue: 'Tuesday',
        wed: 'Wednesday',
        thu: 'Thursday',
        fri: 'Friday',
        sat: 'Saturday',
        sun: 'Sunday',
      };
      const [opens, closes] = (hours as string).split('–');
      return { '@type': 'OpeningHoursSpecification', dayOfWeek: dayMap[day], opens, closes };
    }),
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Specification demo — must not be indexed and must not compete with the
        bakery's real listing. Removed only on the owner's written go-ahead. */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={absolute(route(page, other, slug))} />
    <link rel="alternate" hreflang="x-default" href={absolute(route(page, 'cs', slug))} />

    {/* Self-hosted. The display face is preloaded in both subsets because a
        Czech headline needs glyphs from each. */}
    <link
      rel="preload"
      href={withBase('/fonts/titan-one-latin-400-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('/fonts/titan-one-latin-ext-400-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* The header CTA, the prices and the body text all paint above the fold.
        Without these preloaded, the swap from fallback to real face resizes
        the header's flex row and registers as layout shift. */}
    <link
      rel="preload"
      href={withBase('/fonts/barlow-condensed-latin-700-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('/fonts/archivo-latin-400-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content="Bread Guy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'cs' ? 'cs_CZ' : 'en_GB'} />

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>

  <body class="font-body text-t3">
    <a href="#obsah" class="skip-link">{i18n.nav.skipToContent}</a>
    <Header locale={locale} page={page} slug={slug} />
    <main id="obsah">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
