---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl, t } from '../data/i18n';
import { toRoute, withBase } from '../lib/paths';
import locations from '../data/locations.json';

interface Props {
  title: string;
  description: string;
}

const SITE = Astro.site?.origin ?? 'https://breadguy.cz';
/* Hero photo doubles as the social preview image — JPEG, because some social
   scrapers still don't render WebP previews. */
const OG_IMAGE = '/images/products/focaccia-olive.jpg';

const { title, description } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const i18n = t(locale);
const altLocale = locale === 'cs' ? 'en' : 'cs';

const route = toRoute(Astro.url.pathname);
const csRoute = route.replace(/^\/en/, '') || '/';
/* Keep the trailing slash so hreflang matches the canonical URL exactly. */
const enRoute = csRoute === '/' ? '/en/' : `/en${csRoute}`;
const altPath = withBase(locale === 'cs' ? enRoute : csRoute);

const absolute = (path: string) => `${SITE}${withBase(path)}`;
const canonical = absolute(route);

const structuredData = locations.map((loc) => ({
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: loc.name[locale],
  address: {
    '@type': 'PostalAddress',
    streetAddress: loc.address.split(',')[0],
    addressLocality: 'Brno',
    addressCountry: 'CZ',
  },
  telephone: loc.phone || undefined,
  url: absolute('/'),
  image: absolute(OG_IMAGE),
  aggregateRating: loc.rating
    ? {
        '@type': 'AggregateRating',
        ratingValue: loc.rating,
        reviewCount: loc.reviewCount,
      }
    : undefined,
  openingHoursSpecification: Object.entries(loc.hours)
    .filter(([, v]) => v !== null)
    .map(([day, hours]) => {
      const dayMap: Record<string, string> = {
        mon: 'Monday',
        tue: 'Tuesday',
        wed: 'Wednesday',
        thu: 'Thursday',
        fri: 'Friday',
        sat: 'Saturday',
        sun: 'Sunday',
      };
      const [opens, closes] = (hours as string).split('–');
      return {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: dayMap[day],
        opens,
        closes,
      };
    }),
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="cs" href={absolute(csRoute)} />
    <link rel="alternate" hreflang="en" href={absolute(enRoute)} />
    <link rel="alternate" hreflang="x-default" href={absolute(csRoute)} />

    <meta property="og:site_name" content="Bread Guy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'cs' ? 'cs_CZ' : 'en_GB'} />
    <meta property="og:image" content={absolute(OG_IMAGE)} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content={i18n.hero.photoAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(OG_IMAGE)} />

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="bg-brand-cream text-brand-charcoal font-body antialiased">
    <a href="#obsah" class="skip-link">{i18n.nav.skipToContent}</a>
    <Header locale={locale} />
    <main id="obsah">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      /*
       * Reveal-on-scroll and header elevation.
       *
       * The hidden state is only armed once this script runs, so a visitor
       * without JS — or one where this fails — still sees every section.
       * Readers who ask for reduced motion get everything shown immediately.
       */
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (!reduceMotion && 'IntersectionObserver' in window && targets.length) {
        document.documentElement.classList.add('js-reveal');

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              // Stagger siblings so a grid cascades rather than popping at once.
              const index = Number(el.dataset.revealIndex ?? 0);
              el.style.setProperty('--reveal-delay', `${Math.min(index, 8) * 70}ms`);
              el.classList.add('is-visible');
              observer.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        targets.forEach((el) => observer.observe(el));
      }

      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) {
        const onScroll = () => {
          header.classList.toggle('shadow-lg', window.scrollY > 8);
          header.classList.toggle('shadow-brand-orange/5', window.scrollY > 8);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
