---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

/*
 * One 404 for both languages: a wrong URL carries no reliable locale, and the
 * customer base is Czech, so lead in Czech and repeat the essentials in English.
 */
---

<BaseLayout
  title="Stránka nenalezena — Bread Guy"
  description="Tuto stránku se nepodařilo najít."
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center">
    <p class="font-display font-black text-6xl sm:text-7xl text-brand-orange-text mb-4">404</p>

    <h1 class="font-display font-extrabold text-2xl sm:text-3xl mb-3">Tuto stránku nemáme</h1>
    <p class="text-brand-muted mb-2">
      Odkaz možná zastaral nebo v adrese chybí písmeno.
    </p>
    <p class="text-brand-muted text-sm mb-10" lang="en">
      This page doesn't exist — the link may be out of date.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={withBase("/")}
        class="inline-flex items-center px-6 py-3 bg-brand-orange-deep text-white font-semibold rounded-lg hover:bg-brand-orange-hover transition-colors"
      >
        Zpět na úvod
      </a>
      <a
        href={withBase("/#pobocky")}
        class="inline-flex items-center px-6 py-3 border-2 border-brand-warm font-semibold rounded-lg hover:bg-brand-warm transition-colors"
      >
        Otevírací doba a pobočky
      </a>
    </div>
  </section>
</BaseLayout>
