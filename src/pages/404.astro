---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../data/i18n';
import { route } from '../lib/routes';

/*
 * One 404 for both languages: a wrong URL carries no reliable locale, so lead
 * in Czech. The primary route out is Locations, not Home — a lost visitor is
 * usually looking for an address or an opening time.
 */
const i18n = t('cs');
---

<BaseLayout
  title={i18n.meta.notFoundTitle}
  description={i18n.meta.notFoundDescription}
  locale="cs"
  page="home"
>
  <section class="ground-orange py-s7">
    <div class="max-w-page mx-auto px-s4 flex flex-col gap-s4">
      <p class="font-display text-t6">404</p>
      <h1 class="font-display text-t5 max-w-display">{i18n.notFound.title}</h1>
      <p class="text-t3 max-w-body">{i18n.notFound.text}</p>

      <div class="flex flex-wrap gap-s3 mt-s3">
        <a
          href={route('locations', 'cs')}
          class="tag-notch bg-brand-ink text-brand-chalk font-utility font-bold uppercase text-t2 px-s4 py-s3"
        >
          {i18n.notFound.toLocations}
        </a>
        <a
          href={route('home', 'cs')}
          class="tag-notch bg-brand-chalk text-brand-ink font-utility font-bold uppercase text-t2 px-s4 py-s3"
        >
          {i18n.notFound.toHome}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
